# ============================================================================
# AIRKLIM - Git Ignore Definitivo
# ============================================================================
# Questo file impedisce a Git di committare file non necessari

# ============================================================================
# DIPENDENZE E BUILD (NON COMMITTARE MAI)
# ============================================================================
node_modules/
dist/
build/
.next/
out/
.nuxt/
.cache/
*.tsbuildinfo

# ============================================================================
# PYTHON (NON COMMITTARE)
# ============================================================================
venv/
env/
ENV/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
*.pyc
*.pyo
*.pyd
.Python

# ============================================================================
# FILE UPLOADATI DALL'UTENTE (NON COMMITTARE)
# ============================================================================
# Immagini caricate
public/uploads/images/optimized/
public/uploads/images/thumbnails/
public/uploads/images/extracted/
public/uploads/images/uploaded/

# PDF caricati
public/uploads/catalogs/*.pdf
public/uploads/catalogs/uploaded/

# Mantieni solo le directory vuote con .gitkeep
!public/uploads/images/.gitkeep
!public/uploads/catalogs/.gitkeep

# ============================================================================
# DATI ESTRATTI (NON COMMITTARE - generati automaticamente)
# ============================================================================
data/extracted/
data/extracted-products.json
data/extractedProducts2026.ts
data/categorized_products.json
data/categorizedProducts2026.ts

# ============================================================================
# LOG E REPORT (NON COMMITTARE)
# ============================================================================
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================================
# BACKUP (NON COMMITTARE)
# ============================================================================
backups/
*.backup
*.bak
*.tmp
*.temp

# ============================================================================
# DOCUMENTAZIONE GENERATA (NON COMMITTARE)
# ============================================================================
docs/generated/
reports/

# ============================================================================
# ENVIRONMENT (NON COMMITTARE - CONTIENE SEGRETI)
# ============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.local

# ============================================================================
# IDE E EDITOR (NON COMMITTARE)
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
.history/

# ============================================================================
# SISTEMA OPERATIVO (NON COMMITTARE)
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================================
# TESTING (NON COMMITTARE)
# ============================================================================
coverage/
*.lcov
.nyc_output/
junit.xml
test-results/

# ============================================================================
# DATABASE (NON COMMITTARE)
# ============================================================================
*.db
*.sqlite
*.sqlite3

# ============================================================================
# FILE TEMPORANEI (NON COMMITTARE)
# ============================================================================
*.tmp
*.temp
~*
\#*\#
.\#*

# ============================================================================
# FILE GENERATI AUTOMATICAMENTE (NON COMMITTARE)
# ============================================================================
*.generated.*
*.min.js
*.min.css

# ============================================================================
# DOCUMENTAZIONE RIDONDANTE (NON COMMITTARE)
# ============================================================================
# Mantieni solo README.md e CONTRIBUTING.md
FASE*_COMPLETATA.md
PRIORITA_*_COMPLETATA.md
PROGETTO_*.md
REPORT_*.md
SISTEMA_*.md
STATO_*.md
PIANO_*.md
GUIDA_*.md
MANUALE_*.md
QUICK_*.md
COMPLETAMENTO_*.md
ISTRUZIONI_*.md
GITHUB_*.md
UPLOAD_*.md
SOLUZIONE_*.md
SCANSIONE_*.md

# ============================================================================
# FILE GRANDI (NON COMMITTARE - GitHub limite 100MB)
# ============================================================================
*.zip
*.tar
*.gz
*.rar
*.7z
*.iso
*.dmg
*.exe
*.msi
*.pkg
*.deb
*.rpm

# ============================================================================
# IMMAGINI GRANDI (NON COMMITTARE)
# ============================================================================
public/uploads/images/**/*.psd
public/uploads/images/**/*.ai
public/uploads/images/**/*.sketch
public/uploads/images/**/*.fig

# ============================================================================
# VIDEO (NON COMMITTARE)
# ============================================================================
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.mkv
*.webm

# ============================================================================
# AUDIO (NON COMMITTARE)
# ============================================================================
*.mp3
*.wav
*.ogg
*.flac
*.aac

# ============================================================================
# ARCHIVI (NON COMMITTARE)
# ============================================================================
*.zip
*.tar
*.gz
*.rar
*.7z

# ============================================================================
# NOTE FINALI
# ============================================================================
# Questo .gitignore è stato ottimizzato per:
# 1. Ridurre la dimensione del repository
# 2. Evitare errori di push su GitHub
# 3. Mantenere solo i file essenziali
# 4. Proteggere dati sensibili
#
# File che DEVONO essere committati:
# - src/ (codice sorgente)
# - server/ (backend)
# - scripts/ (script di automazione)
# - public/ (asset statici, ma non uploads)
# - README.md
# - CONTRIBUTING.md
# - package.json
# - requirements.txt
# - .env.example
# - setup.sh
# - start_server.sh
# ============================================================================
