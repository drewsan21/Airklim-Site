# ---- Build: frontend (Vite + TypeScript) ----
FROM node:18-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
# Type-check and build; fails the image build on TS errors
RUN npm run build

# ---- Production: serve static bundle with nginx ----
FROM nginx:1.25-alpine

# Security headers, gzip, SPA fallback
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  gzip on;\n  gzip_types text/css application/javascript application/json image/svg+xml;\n  location / {\n    try_files $uri $uri/ /index.html;\n    add_header X-Frame-Options "SAMEORIGIN" always;\n    add_header X-Content-Type-Options "nosniff" always;\n    add_header Referrer-Policy "strict-origin-when-cross-origin" always;\n  }\n  location ~* \\.(js|css|png|jpg|jpeg|gif|svg|webp|woff2?)$ {\n    expires 30d;\n    add_header Cache-Control "public, immutable";\n  }\n}\n' > /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O /dev/null http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
