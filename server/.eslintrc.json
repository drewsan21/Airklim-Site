{
  "root": true,
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-unused-vars": [
      "error",
      { "args": "none", "varsIgnorePattern": "^_", "ignoreRestSiblings": true }
    ],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-console": "off"
  }
}
